+    c.update(0)
+    _run_window(c)
+    r = c.update(50)
+    assert c.n_updates == 1 and r["reward/lang_weights/adaptive_updates"] == 1.0
+    assert 2.5 < c.in_force["yor"] <= 2.5 * 1.25 + 1e-9 and r["reward/lang_weights/yor"] == c.in_force["yor"]          # boosted, within +25 % per update
