+    fl = flags()
+    replaced = set()
+    while sum(fl) < n_target and rounds < max_refills:
+        deficit = n_target - sum(fl)
+        todo = [g for g, ok in enumerate(fl) if not ok and g not in replaced][:deficit]
+        if not todo:
