+def test_guide_share_cap_scales_only_when_the_share_is_above_the_cap():
+    adv = torch.tensor([1.0, -1.0, 1.0, 3.0, -1.0, 1.0])
+    lengths = torch.tensor([10.0, 10.0, 10.0, 10.0, 10.0, 10.0])
