+    wasted = 0
+    for g, p in enumerate(prompt_idx):
+        d = by_lang.setdefault(iso_of(p), {"generated": 0, "dropped_flat": 0, "surplus": 0, "kept": 0})
+        d["generated"] += 1
+        if g in keep_set:
+            d["kept"] += 1
+        elif not fl[g]:
