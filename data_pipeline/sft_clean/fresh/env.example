# copy to env.sh on the instance and `source env.sh` (NEVER commit a real token; env.sh is created by hand)
export HF_TOKEN=                      # write access to ${HF_ORG_LEGACY}/sabiyarn-clean-sft-2026-10-28 (read) and the private pack repo (write); the lead places the token here on the instance; never commit it
export ROOT=/workspace/work      # everything lives here
export HUB_REPO=${HF_ORG_LEGACY}/sabiyarn-clean-sft-2026-10-28
export PACK_REPO=${HF_ORG}/sabiyarn-clean-sft-packs-2026-10-29      # PRIVATE (Amendment 4 item 6); created by push_packs.py if missing
export GATE_RULE=cal                  # cal (owner decision 2026-10-29) | old
export QE_PROCS=auto                  # auto = step 25 probes 1/2/4 processes and picks the best (qe_procs.json); a number fixes N and skips the probe
export QE_BATCH=128                   # used when QE_PROCS is a number; the probe tries QE_BATCHES
export QE_BATCHES="128 256"
export PACK_WORKERS=8                 # prepare_sft tokenisation processes
export MIN_FREE_GB=12                 # a step refuses to start / the watcher warns below this
export STOP_AFTER_FIT=0               # 1 = stop after the OLD+CAL keep-rate report so that it can be read before anything is applied
export NC_ALLOW=howard-nlp/ibom-mt     # owner exception: NC sources that STAY (tag nc_exception=ibom-mt); empty = none
export HIDDEN_NC=1                    # hidden-NC filter on rows whose NC origin is identifiable per row (nc_hidden.py); 0 = off
export HIDDEN_DROP_SOURCES=           # owner decision: whole sources to drop, e.g. "UBC-NLP/AfroLingu-MT" (default none: only listed)
export HIDDEN_ALLOW_BELOW=0           # 1 = allow languages below 2,000 pairs after the hidden-NC filter (default: the step stops and says which)
export A2_FRAC=0.25                   # A2 = this fraction of A0's draws, stratified per language (shared by A2-base, A2-up6, A2-up12, Gemma-3-1B-it)
export A2_FLOOR=                      # optional per-language floor of draws (sampler.py subset --floor-draws; T1's call)
export EXTRA_LANGS="nde ful knc tzm"   # Amendment 6 languages built by extra_sources.py (step 15)
export FUL_MIN_SIM=1.06               # NLLB-mined Fulah: keep rows with LASER margin >= this (set runs 1.05..1.25: 1.05 = 1.51 M rows, 1.06 = about 0.61 M, 1.08 = about 0.15 M); the QE gate comes on top
export EXTRA_ALLOW_MISSING=           # source names (nde ful_wikimedia ful_xlent ful_fub_bible ful_nllb_mined knc_gamayun knc_kanurimt tzm_seed tzm_translatewiki tzm_pontoon) whose download failure is not fatal
export QE_CAP=150000                  # pairs per language that are QE-scored (deterministic monotone hash sample; thin languages in full); 0 = no cap. Not scored = not kept. Raise later: only the new keys are scored.
export QE_FAST=1                      # 1 = qe_fast.py (separate length-sorted source / translation passes, token-budget batches, English-source cache); 0 = comet predict only
export QE_RATE=129                    # measured pairs/s, only used to print the hours of the cap table
