# Copy to `.env` and fill in. `.env` is git-ignored. Every private identifier of this project (organisation names, model
# checkpoints, datasets we built, buckets, hosts, tokens) is read from the environment; none of them is written in the code.
# `gemma_mt.utils.load_yaml` expands ${VAR} in the YAML configs and loads this file first; shell scripts do `set -a; . ./.env; set +a`.

# ---- Hugging Face
HF_TOKEN=                      # read token (gated benchmarks such as FLORES+)
HF_WRITE_TOKEN=                # write token, only for the push scripts
HF_ORG=                        # organisation that owns our models and datasets (the model/dataset names are in the configs)
HF_ORG_LEGACY=                 # second organisation that held the first-generation datasets (only the early data builders use it)

# ---- S3-compatible object storage (large intermediate data moves through it, never through the laptop)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_PREFIX=                     # run prefix inside the bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- rented GPU / data boxes (ssh)
SSH_KEY=~/.ssh/<key>
BOX_HOST=                      # host of the box a script talks to
BOX_PORT=
GPU_BOX_HOST=                  # training box (a100_worker.py)
GPU_BOX_PORT=
WORK_ROOT=/workspace/work      # working directory on the boxes (data, packs, schedules, runs)

# ---- experiment tracking (optional)
WANDB_API_KEY=
